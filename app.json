{
  "expo": {
    "name": "Occultum",
    "slug": "occultum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "scheme": "occultum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./app/assets/icon.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.antmitt.occultum"
    },
    "web": {
      "output": "static",
      "favicon": "./app/assets/icon.png",
      "name": "Occultum",
      "shortName": "Occultum",
      "description": "Sprachen kodieren, dekodieren und eigene Alphabete verwalten.",
      "lang": "de",
      "themeColor": "#004e8d",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4a874c4-1862-4396-afd7-45fd3ed0bb80"
      }
    },
    "owner": "antmitt"
  }
}
