{
  "expo": {
    "name": "Occultum",
    "slug": "occultum",
    "version": "1.1.4",
    "orientation": "portrait",
    "icon": "./app/assets/icon.png",
    "scheme": "occultum",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "icon": "./app/assets/icon.png",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.antmitt.occultum"
    },
    "web": {
      "output": "static",
      "favicon": "./app/assets/icon.png",
      "name": "Occultum",
      "shortName": "Occultum",
      "description": "Sprachen kodieren, dekodieren und eigene Alphabete verwalten.",
      "lang": "de",
      "themeColor": "#3e4e63",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "antmitt",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "77d1c4a9-457d-49a8-b66f-4359b742688a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/77d1c4a9-457d-49a8-b66f-4359b742688a"
    }
  }
}
